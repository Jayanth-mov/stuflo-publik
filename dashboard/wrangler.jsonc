{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stuflo-dashboard-local",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "stuflo-dashboard-local"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "stuflo-local-dashboard-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "NEXTJS_ENV": "production",
    "STUFLO_API_URL": "http://localhost:8787"
  }
}
