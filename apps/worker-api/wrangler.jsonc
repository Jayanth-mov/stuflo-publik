{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stuflo-api-local",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "local",
    "AI_GATEWAY_ID": "default",
    "AI_GATEWAY_MODEL": "gpt-6-sol",
    "AI_GATEWAY_LUNA_MODEL": "gpt-6-luna",
    "APP_ORIGIN": "http://localhost:3000",
    "API_ORIGIN": "http://localhost:8787",
    "STRIPE_LIVE_MODE": "false"
  },
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "stuflo-local-attachments"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "17001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "17002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "ADMIN_RATE_LIMITER",
      "namespace_id": "17003",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "17004",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "StuAgent",
        "class_name": "StuAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "StuAgent"
      ]
    }
  ]
}
