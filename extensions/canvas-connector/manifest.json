{
  "manifest_version": 3,
  "name": "StuFlo Canvas Connector",
  "version": "0.4.5",
  "description": "Connect and quietly refresh your logged-in Canvas session in StuFlo.",
  "permissions": ["activeTab", "alarms", "cookies", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://app.stuflo.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "StuFlo Canvas Connector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.stuflo.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
